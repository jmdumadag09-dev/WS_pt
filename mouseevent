<!DOCTYPE html>
<html>
<head>
    <title>Mouse Move Example</title>
</head>
<body>

    <h2>Move your mouse around the page!</h2>

    <p id="position">Mouse position will appear here.</p>

    <script>
        document.addEventListener('mousemove', function(event) {
            console.log('Mouse moved to: X=' + event.clientX + ', Y=' + event.clientY);
        });
    </script>

</body>
</html>
